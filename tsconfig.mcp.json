{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "strict": true,
    "types": ["node"],
    "declaration": false,
    "outDir": "lib/mcp",
    "rootDir": "mcp/src",
    "rootDirs": ["mcp", "lib/types"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true
  },
  "include": ["mcp/src/**/*.ts"]
}
